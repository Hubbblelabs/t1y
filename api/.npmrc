# react-transliterate@^1.1.9 declares a peer dep on react@^16, but this
# project is on React 19 (Next.js 16's requirement). The package works fine
# with 19 in practice; this just stops npm from treating that declared-but-
# unenforced mismatch as a hard install failure. Needed on every install,
# including Vercel's build — a machine-local `--legacy-peer-deps` flag isn't
# available there.
legacy-peer-deps=true
