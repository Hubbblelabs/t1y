// ---------------------------------------------------------------------------
// Identity — Better Auth core tables plus platform fields
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  emailVerified      Boolean    @default(false)
  image              String?
  role               UserRole   @default(PATIENT)
  status             UserStatus @default(PENDING)
  /// Set when a temporary/dummy password is issued (single-participant
  /// activation or bulk import) so the app can force a change on first
  /// sign-in. False for self-registered accounts, who chose their own.
  mustChangePassword Boolean    @default(false)
  timezone           String     @default("UTC")
  locale             String     @default("en")
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  /// The parent account this child belongs to. Null for ADMIN users and for
  /// participants enrolled before households existed — those are treated as
  /// a household of one, so nothing breaks for them.
  householdId String?

  sessions Session[]
  accounts Account[]

  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  profile   Profile?
  adminUser AdminUser?

  glucoseReadings GlucoseReading[]
  medications     Medication[]
  medicationLogs  MedicationLog[]
  insulinLogs     InsulinLog[]
  meals           Meal[]
  exerciseLogs    ExerciseLog[]
  hba1cRecords    HbA1cRecord[]
  healthMetrics   HealthMetric[]
  reminders       Reminder[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]

  studyEnrollments StudyParticipant[]
  studyAccess      StudyAccess[]      @relation("StudyAccessUser")

  auditLogsAsActor   AuditLog[] @relation("AuditActor")
  auditLogsAsSubject AuditLog[] @relation("AuditSubject")

  authoredCalculators Calculator[]         @relation("CalculatorCreator")
  supportThreads      SupportThread[]      @relation("SupportSubject")
  supportMessages     SupportMessage[]     @relation("SupportAuthor")
  authoredEducation EducationContent[]     @relation("EducationAuthor")
  authoredQuizzes   Quiz[]                 @relation("QuizAuthor")
  createdCampaigns  NotificationCampaign[] @relation("CampaignCreator")
  createdStudies    ResearchStudy[]        @relation("StudyCreator")
  dataExports       DataExport[]
  uploadedAssets    MediaAsset[]
  customExercises   Exercise[]             @relation("ExerciseCreator")

  quizAttempts  QuizAttempt[]
  topicProgress TopicProgress[]
  syncEvents    SyncEvent[]
  quizBadges    QuizBadge[]

  @@index([householdId])
  @@index([role, status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

/// Better Auth database-backed rate limiting (shared across serverless instances).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int    @default(0)
  lastRequest BigInt @default(0)

  @@index([key])
}

/// Rate limiting for the platform's own REST endpoints.
model ApiRateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Households
//
// A parent in this study may enrol more than one child. Each child keeps
// their own `User` row — that is what every route, quiz attempt, progress
// record and research export already keys on, and splitting children out
// into a non-User entity would rewrite all of it for no clinical gain.
// A Household is purely the grouping above them: the parent's own contact
// details, the MPIN that gates glucose entry, and the fact that these
// children share one sign-in.
//
// Sign-in stays Better Auth's email+password against a child `User`. The
// parent's email/phone resolves to the household, the app shows the child
// picker, and the chosen child's account is the one the session belongs to
// — see lib/services/households.ts.
// ---------------------------------------------------------------------------

model Household {
  id String @id @default(cuid())

  /// What the parent types to sign in. Distinct from any child `User.email`
  /// (which must stay unique per child), and the reason a parent with three
  /// children still has exactly one set of credentials to remember.
  email String  @unique
  phone String? @unique

  parentName String

  /// scrypt hash of the 4-6 digit MPIN gating glucose entry, and null until
  /// the parent sets one in Profile. Never the same secret as the account
  /// password — a PIN this short is only a "not the child's fingers" gate,
  /// so it is rate-limited server-side and resettable only with the account
  /// password. See lib/services/mpin.ts.
  mpinHash  String?
  mpinSetAt DateTime?

  /// Consecutive failed MPIN attempts, reset to 0 on success. Lock-out is
  /// derived from this rather than stored, so it expires on its own.
  mpinFailedAttempts Int       @default(0)
  mpinLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children User[]

  @@index([phone])
}

// ---------------------------------------------------------------------------
// Participant and staff profiles
// ---------------------------------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  /// Stable pseudonymous identifier used in research exports (e.g. "P001").
  participantCode String @unique

  /// The child's full name as one field — the study never needed first/last
  /// split out (nothing sorts, matches, or exports on either part alone),
  /// and splitting a name that isn't naturally "first + last" in every
  /// family's convention was friction the form didn't need.
  name        String
  dateOfBirth DateTime?
  sex         Sex       @default(UNSPECIFIED)
  phone       String?
  city        String?
  country     String?

  diabetesType      DiabetesType      @default(UNSPECIFIED)
  diagnosisYear     Int?
  treatmentModality TreatmentModality @default(UNSPECIFIED)
  heightCm          Float?
  baselineWeightKg  Float?
  primaryClinician  String?

  emergencyContactName  String?
  emergencyContactPhone String?

  /// Answers to admin-defined [ProfileFieldDefinition]s, keyed by
  /// `ProfileFieldDefinition.key`. Deliberately a JSON bucket rather than a
  /// column per field: an admin can invent a field at any time, and giving
  /// it a real column would need a migration for every one. A field that is
  /// later deactivated leaves its answers here untouched — deactivating
  /// only stops the field from being *asked* for, it never deletes what was
  /// already collected.
  customFieldValues Json @default("{}")

  /// Per-child switch for the app's IC/ISF calculator, on top of the global
  /// `ic_isf_calculator` feature flag. Defaults to unlocked for every
  /// child — the earlier design gated this per child until a coordinator
  /// confirmed real prescribed ratios were on file; that per-child clinical
  /// check was deliberately removed, so this now only exists to let a
  /// coordinator turn the calculator back off for one child specifically
  /// (e.g. at a care team's request), not to turn it on.
  icIsfUnlocked Boolean @default(true)

  /// Which app features this participant is enrolled for, set when the
  /// account is created and editable afterwards. Keys are
  /// lib/services/participant-features.ts's registry — that file is the
  /// source of truth for which are valid, the same closed-allowlist pattern
  /// as FeatureFlag.key. A parent's app hides what is not in this list, and
  /// the corresponding write endpoints (glucose, insulin, meals) refuse a
  /// request for a feature that is not.
  enabledFeatures String[] @default(["GLUCOSE_LOGGING", "INSULIN_LOGGING", "CARB_LOGGING", "HELP_BOOK", "QUIZZES", "HELP_SUPPORT"])

  /// Maintained on every health-data write so participant lists stay cheap to query.
  lastActivityAt DateTime?
  onboardedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([diabetesType])
  @@index([lastActivityAt])
  @@index([name])
}

/// An admin-defined field on the parent-facing profile form, on top of the
/// fixed set of columns already on [Profile].
///
/// `key` is the stable identifier an answer is filed under in
/// `Profile.customFieldValues` — immutable once set, because renaming it
/// would orphan every answer already collected under the old key.
///
/// There is deliberately no delete: retiring a field is done by setting
/// `active: false`, which stops the app asking for it and forces `required`
/// back to false at the same time (see updateProfileFieldDefinition) —
/// existing answers under its key are left exactly where they are. A hard
/// delete would either orphan that data or require cascading it away, and
/// this is self-reported study data — nothing here should vanish because an
/// admin changed their mind about a form.
model ProfileFieldDefinition {
  id  String @id @default(cuid())
  key String @unique

  fieldType ProfileFieldType @default(TEXT)
  /// Free-text grouping label (e.g. "Additional details") the app renders
  /// this field under — not a fixed enum, so an admin can group fields
  /// without a code change.
  section   String           @default("Additional details")

  /// Enforced client-side at save time only, and only while `active` — never
  /// retroactively against rows already in the database. A profile saved
  /// while a field was required and later left blank (because the field was
  /// deactivated, or the parent simply skipped an optional one) is never
  /// treated as broken data.
  required  Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  labelEn String
  labelTa String?
  hintEn  String?
  hintTa  String?

  /// True for a question the app has always asked, whose answer is stored in
  /// a real `Profile` column (name, dateOfBirth, phone, heightCm…) rather than
  /// in `customFieldValues`. `key` is then the column's name.
  ///
  /// These are registered here so the whole set of questions — built in and
  /// added — can be seen and described in one place, with its type and
  /// validation. They are deliberately kept out of what the app fetches and
  /// out of the save-time "required" check (see profile-fields.ts): the app
  /// still asks them from its own screens, and treating one as an ordinary
  /// custom answer would both duplicate it on screen and fail every save.
  builtIn Boolean @default(false)

  /// Asked in the chat when a parent first signs up, rather than left to the
  /// profile screen afterwards.
  showOnSignup Boolean @default(false)

  /// The sentence the sign-up chat asks ("What year were they diagnosed with
  /// Type 1 diabetes?"), which is not the same thing as the field's label
  /// ("Diagnosis year"). Only used when `showOnSignup` is on; falls back to
  /// the label when blank.
  promptEn String?
  promptTa String?

  /// The checks an answer must pass, in the shape that suits `fieldType`:
  ///   TEXT   { minLength, maxLength, format: "ANY" | "LETTERS" }
  ///   NUMBER { min, max, wholeNumber, upToCurrentYear, notBeforeYearOf }
  ///   DATE   { notInFuture, minAgeYears, maxAgeYears }
  ///   CHOICE — none; the options are the validation.
  /// Validated and described by lib/services/profile-field-rules.ts.
  rules Json?

  /// Marks this as clinical information about the child rather than
  /// administrative detail, which is what makes it available to calculators
  /// as a named value (see lib/services/health-data-catalogue.ts).
  ///
  /// Off by default, deliberately. A field has to be deliberately declared
  /// medical before a dosing formula can read it — nobody should be able to
  /// wire "preferred contact time" into an insulin calculation by accident,
  /// and the flag is also the honest boundary for what this study treats as
  /// health data rather than contact detail.
  isMedical Boolean @default(false)

  /// The unit a numeric medical field is recorded in ("kg", "cm", "mg/dL").
  /// Shown beside the value everywhere it appears, so a formula author can
  /// see what they are dividing by.
  unit String?

  /// For `fieldType: CHOICE` only —
  /// `[{ "value": "...", "labelEn": "...", "labelTa": "...", "numericValue": 1 }]`.
  ///
  /// `numericValue` is what a calculator sees when this choice is selected,
  /// and is required only on a field that is both CHOICE and medical: a
  /// formula cannot do arithmetic on the word "male", so if such a field is
  /// to be usable in one, each option has to say what number it stands for.
  options Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Staff-specific metadata. Authorisation always derives from `User.role`.
model AdminUser {
  id     String @id @default(cuid())
  userId String @unique

  jobTitle     String?
  department   String?
  organization String?
  phone        String?
  invitedById  String?
  invitedAt    DateTime?

  /// Restricts this staff account to exactly these capabilities (see
  /// lib/permissions/roles.ts's Capability catalogue) — never more than
  /// ADMIN's own ceiling, even if this list somehow drifted to include
  /// something else. Empty (the default for every account created before
  /// this existed, and for a super-admin) means full ADMIN access — Prisma
  /// has no nullable list type, so empty is the "unrestricted" sentinel
  /// rather than `null`.
  capabilities String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Glucose
// ---------------------------------------------------------------------------

model GlucoseReading {
  id     String @id @default(cuid())
  userId String

  value      Float
  unit       GlucoseUnit    @default(MG_DL)
  context    GlucoseContext @default(RANDOM)
  measuredAt DateTime
  source     DataSource     @default(MANUAL)
  deviceId   String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@index([userId, context, measuredAt])
  @@index([measuredAt])
}

// ---------------------------------------------------------------------------
// Medications
// ---------------------------------------------------------------------------

model Medication {
  id     String @id @default(cuid())
  userId String

  name          String
  genericName   String?
  dosageText    String
  form          MedicationForm @default(TABLET)
  route         String?
  frequency     String
  timesPerDay   Int            @default(1)
  /// Local times of day ("08:00"), interpreted in the participant's timezone.
  scheduleTimes String[]
  instructions  String?
  prescribedBy  String?
  reason        String?
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      MedicationLog[]
  reminders Reminder[]

  @@index([userId, isActive])
  @@index([userId, startDate])
}

model MedicationLog {
  id           String @id @default(cuid())
  userId       String
  medicationId String

  scheduledFor DateTime?
  takenAt      DateTime?
  status       MedicationLogStatus @default(PENDING)
  doseAmount   Float?
  doseUnit     String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  /// Prevents duplicate entries for the same scheduled dose.
  @@unique([medicationId, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([userId, status, scheduledFor])
  @@index([medicationId, status])
}

// ---------------------------------------------------------------------------
// Insulin — recorded administrations only. The platform never recommends doses.
// ---------------------------------------------------------------------------

model InsulinLog {
  id     String @id @default(cuid())
  userId String

  insulinName     String
  insulinType     InsulinType
  doseUnits       Float
  unit            String          @default("IU")
  administeredAt  DateTime
  injectionSite   InjectionSite?
  mealAssociation MealAssociation @default(NONE)
  mealId          String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal Meal? @relation(fields: [mealId], references: [id], onDelete: SetNull)

  @@index([userId, administeredAt])
  @@index([userId, insulinType, administeredAt])
}

// ---------------------------------------------------------------------------
// Nutrition — values are participant-reported unless `nutritionSource` says otherwise.
// ---------------------------------------------------------------------------

model Meal {
  id     String @id @default(cuid())
  userId String

  name       String?
  mealType   MealType
  consumedAt DateTime

  totalCarbsGrams   Float?
  totalCalories     Float?
  totalProteinGrams Float?
  totalFatGrams     Float?
  totalFiberGrams   Float?

  /// Name of the validated nutrition database the values came from, if any.
  nutritionSource String?
  photoUrl        String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       MealItem[]
  insulinLogs InsulinLog[]

  @@index([userId, consumedAt])
  @@index([userId, mealType, consumedAt])
}

model MealItem {
  id     String @id @default(cuid())
  mealId String

  name          String
  quantity      Float   @default(1)
  unit          String  @default("serving")
  carbsGrams    Float?
  calories      Float?
  proteinGrams  Float?
  fatGrams      Float?
  fiberGrams    Float?
  /// Identifier within the external food database, when one was used.
  referenceCode String?

  createdAt DateTime @default(now())

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

// ---------------------------------------------------------------------------
// Exercise
// ---------------------------------------------------------------------------

/// Catalogue of activity types. System entries are shared; participants may add their own.
model Exercise {
  id          String           @id @default(cuid())
  name        String
  category    ExerciseCategory @default(OTHER)
  /// Metabolic equivalent, when a referenced value is available.
  metValue    Float?
  description String?
  isSystem    Boolean          @default(true)
  isActive    Boolean          @default(true)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User?         @relation("ExerciseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  logs      ExerciseLog[]

  @@unique([name, createdById])
  @@index([category, isActive])
}

model ExerciseLog {
  id     String @id @default(cuid())
  userId String

  exerciseId      String?
  activityName    String
  category        ExerciseCategory  @default(OTHER)
  durationMinutes Int
  intensity       ExerciseIntensity @default(MODERATE)
  caloriesBurned  Float?
  distanceKm      Float?
  steps           Int?
  performedAt     DateTime
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([userId, performedAt])
  @@index([userId, category, performedAt])
}

// ---------------------------------------------------------------------------
// HbA1c
// ---------------------------------------------------------------------------

model HbA1cRecord {
  id     String @id @default(cuid())
  userId String

  valuePercent   Float
  valueMmolMol   Float?
  measuredAt     DateTime
  source         HbA1cSource @default(LABORATORY)
  laboratoryName String?
  orderedBy      String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, measuredAt])
  @@index([userId, measuredAt])
  @@index([measuredAt])
}

// ---------------------------------------------------------------------------
// Health metrics — extensible without schema changes
// ---------------------------------------------------------------------------

/// A metric that can be tracked. New metrics are added as rows, not columns.
model HealthMetricDefinition {
  id  String @id @default(cuid())
  key String @unique

  label          String
  description    String?
  unit           String
  valueType      MetricValueType @default(NUMERIC)
  /// Populated for COMPOSITE metrics such as blood pressure (systolic / diastolic).
  primaryLabel   String?
  secondaryLabel String?
  /// Plausibility bounds used for input validation only — not a clinical judgement.
  minValue       Float?
  maxValue       Float?
  precision      Int             @default(1)
  isSystem       Boolean         @default(true)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurements HealthMetric[]
  thresholds   ClinicalThreshold[]

  @@index([isActive, sortOrder])
}

model HealthMetric {
  id           String @id @default(cuid())
  userId       String
  definitionId String

  value          Float?
  secondaryValue Float?
  textValue      String?
  unit           String
  measuredAt     DateTime
  source         DataSource @default(MANUAL)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition HealthMetricDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([userId, definitionId, measuredAt])
  @@index([userId, measuredAt])
}

/// Clinician-configured thresholds. Nothing in the product invents these values.
model ClinicalThreshold {
  id    String         @id @default(cuid())
  key   String
  scope ThresholdScope @default(GLOBAL)

  studyId String?
  userId  String?

  /// Domain the threshold applies to: "glucose", "hba1c", or a health metric key.
  domain       String
  context      String?
  definitionId String?

  unit      String
  lowValue  Float?
  highValue Float?
  label     String
  /// Provenance — the guideline or clinician that defined the value.
  source    String
  isActive  Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  study      ResearchStudy?          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  definition HealthMetricDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([key, scope, studyId, userId])
  @@index([domain, isActive])
  @@index([scope, studyId])
}

// ---------------------------------------------------------------------------
// Reminders and notifications
// ---------------------------------------------------------------------------

model Reminder {
  id     String @id @default(cuid())
  userId String

  type       NotificationType
  title      String
  body       String?
  /// Local time of day ("08:00"), interpreted in `timezone`.
  timeOfDay  String?
  recurrence ReminderRecurrence @default(DAILY)
  /// ISO weekday numbers (1 = Monday) for WEEKLY recurrence.
  daysOfWeek Int[]
  dayOfMonth Int?
  timezone   String             @default("UTC")
  startsAt   DateTime?
  endsAt     DateTime?
  enabled    Boolean            @default(true)

  medicationId    String?
  lastTriggeredAt DateTime?
  nextTriggerAt   DateTime?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([enabled, nextTriggerAt])
}

model NotificationCampaign {
  id     String           @id @default(cuid())
  title  String
  body   String
  type   NotificationType @default(GENERAL)
  status CampaignStatus   @default(DRAFT)

  targetType    CampaignTargetType @default(ALL_PARTICIPANTS)
  targetRole    UserRole?
  targetStudyId String?
  targetUserIds String[]

  scheduledAt   DateTime?
  sentAt        DateTime?
  cancelledAt   DateTime?
  cancelledById String?

  totalRecipients Int @default(0)
  deliveredCount  Int @default(0)
  failedCount     Int @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User           @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  targetStudy   ResearchStudy? @relation(fields: [targetStudyId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  campaignId String?
  type       NotificationType
  title      String
  /// Kept free of specific health values — previews surface on lock screens.
  body       String
  data       Json?
  status     DeliveryStatus   @default(PENDING)
  sentAt     DateTime?
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([campaignId])
}

model DeviceToken {
  id     String @id @default(cuid())
  userId String

  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model EducationContent {
  id     String        @id @default(cuid())
  /// Language-independent topic identity. Shared across the EN/TA pair —
  /// that pairing IS the translation link; see ContentLocale.
  slug   String
  locale ContentLocale @default(EN)
  title  String

  description String?
  excerpt     String?
  category    EducationCategory
  /// Rich text stored as sanitised HTML, rendered from `bodySource`.
  body        String

  /// Author-editable source (Markdown by default). `body` is derived from
  /// this on every save — never edited directly once bodySource is set.
  bodySource String?
  bodyFormat ContentBodyFormat @default(HTML)

  /// Ordered `{paragraph, imageUrl, imageKey}[]` — the Help Book reading
  /// screen's image-above-text layout, where the image changes to match
  /// whichever paragraph is on screen. Null/empty means "not migrated to
  /// block layout yet"; the reader falls back to `body`. A block with no
  /// `imageUrl` inherits the previous block's image (or the topic's
  /// `thumbnailUrl`, or a generic fallback) — see
  /// scripts/split-content-blocks.ts and ContentBlock's own doc.
  contentBlocks Json?

  mediaType          MediaType @default(NONE)
  mediaUrl           String?
  mediaKey           String?
  thumbnailUrl       String?
  durationMinutes    Int?
  readingTimeMinutes Int?

  /// External references / citations backing the content.
  externalReferences String[]
  tags               String[]

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  version     Int           @default(1)
  viewCount   Int           @default(0)
  sortOrder   Int           @default(0)

  /// sha256 of the source .docx, set by scripts/import-content.ts. Lets a
  /// re-run skip unchanged documents entirely.
  importChecksum String?
  importedAt     DateTime?

  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("EducationAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([slug, locale])
  @@index([status, locale, category])
  @@index([slug])
  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// Calculators
//
// Study staff define these through the dashboard: a set of named inputs a
// parent fills in, and a set of results computed from them by formulas
// written in the closed arithmetic language in lib/utils/formula.ts.
//
// A calculator is IMMUTABLE once created. There is no edit path for its
// inputs, outputs or formulas — only `active`, which hides it. This is
// deliberate and is the feature's main safety property: these formulas
// produce insulin guidance shown to a parent, so a calculator a family used
// on Tuesday must still mean the same thing when a clinician reviews it on
// Friday. Changing a formula means creating a new calculator and hiding the
// old one, which leaves both on the record.
// ---------------------------------------------------------------------------

model Calculator {
  id  String @id @default(cuid())
  /// Stable identity for the mobile client. Generated, never author-typed.
  key String @unique

  nameEn        String
  nameTa        String?
  descriptionEn String?
  descriptionTa String?

  /// Ordered `{key, labelEn, labelTa, unit, min, max, decimals, helpEn,
  /// helpTa}[]` — the numbers a parent is asked for. `key` is what the
  /// formulas below refer to.
  inputs Json

  /// Ordered `{key, labelEn, labelTa, unit, decimals, expression}[]` — each
  /// result and the formula producing it. A formula may reference any input
  /// key, and any output key declared before it.
  outputs Json

  /// Shown with the results. The place for "check with your doctor before
  /// changing a dose" — every calculator in this product needs one.
  noteEn String?
  noteTa String?

  /// The only mutable field. False hides the calculator from the app while
  /// leaving it, and its formulas, on the record.
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  /// Set when a newer calculator supersedes this one, purely for display
  /// ("replaced by…") — superseding never rewrites the old row.
  supersededById String?

  createdById String
  createdAt   DateTime @default(now())
  /// Tracks `active` flips only; the rest of the row never changes.
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CalculatorCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// Help and support
//
// A parent asks a question about their child; a coordinator answers it. One
// thread per question, so a conversation stays together and the answer is
// never separated from what was asked.
//
// Threads hang off the child's own `User` account rather than a household,
// because that is who the parent is signed in as — which makes a message
// automatically about the right child, with no way to file it against a
// sibling by mistake.
// ---------------------------------------------------------------------------

enum SupportThreadStatus {
  /// A parent has written and nobody has answered yet. The only state that
  /// needs anyone to do anything, so it is what the inbox sorts to the top.
  AWAITING_REPLY
  /// A coordinator has answered. A parent writing again flips it back.
  ANSWERED
  /// Dealt with, and kept for the record. Nothing is ever deleted.
  CLOSED
}

enum SupportAuthorRole {
  PARENT
  ADMIN
}

model SupportThread {
  id String @id @default(cuid())

  /// The child this question is about — the account the parent was signed
  /// in as when they asked.
  userId String

  subject String
  status  SupportThreadStatus @default(AWAITING_REPLY)

  /// Sorts the inbox without counting messages on every row.
  lastMessageAt DateTime @default(now())
  /// When a coordinator first answered, for "how long are families waiting".
  firstRepliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation("SupportSubject", fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model SupportMessage {
  id       String @id @default(cuid())
  threadId String

  authorId String
  /// Stored rather than derived from the author's current role: a staff
  /// member whose account is later changed must not retroactively turn their
  /// past replies into parent messages.
  authorRole SupportAuthorRole

  body String

  /// An optional link to something the family wants to show — a photo of a
  /// meter, a clinic letter. Restricted to Google Drive (see
  /// lib/services/support.ts): this study has no file-storage or virus-
  /// scanning story for parent uploads, and a link to a service they already
  /// use is a far smaller surface than accepting arbitrary files or URLs.
  linkUrl String?

  /// When the other side actually opened it, which is what the app shows as
  /// "read" beside a sent message.
  readAt DateTime?

  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation("SupportAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
}

model MediaAsset {
  id     String @id @default(cuid())
  key    String @unique
  bucket String
  url    String

  contentType String
  sizeBytes   Int
  kind        AssetKind @default(OTHER)
  purpose     String
  checksum    String?

  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById, createdAt])
}

// ---------------------------------------------------------------------------
// Quizzes
//
// Question types are exactly what the source curriculum documents contain:
// true/false, single choice, matching, and step ordering. Short-answer /
// free-text items are deliberately not modelled — auto-grading free text in
// two languages isn't reliable, and a study needs comparable scores. Those
// items get converted to single-choice, or moved into the article body as
// an FAQ, during content review.
// ---------------------------------------------------------------------------

enum QuizQuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
  MATCHING
  ORDERING
}

model Quiz {
  id     String        @id @default(cuid())
  slug   String
  locale ContentLocale @default(EN)

  /// EducationContent.slug of the topic this quiz belongs to (language-
  /// independent — the same quiz slug pairs with either locale's article).
  topicSlug        String?
  title            String
  description      String?
  /// Percent required to pass. Null = not graded pass/fail, only scored.
  passingScore     Int?    @default(70)
  /// 0 = unlimited attempts.
  maxAttempts      Int     @default(0)
  shuffleQuestions Boolean @default(false)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  version     Int           @default(1)

  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User           @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  badges    QuizBadge[]

  @@unique([slug, locale])
  @@index([status, locale])
  @@index([topicSlug, locale])
}

model QuizQuestion {
  id     String           @id @default(cuid())
  quizId String
  type   QuizQuestionType

  /// Stable across the EN and TA versions of the same question, so an
  /// analyst can compare responses across languages, and so the offline
  /// sync payload can reference a question without a server-assigned id.
  questionKey String
  prompt      String
  explanation String?
  imageUrl    String?
  points      Int     @default(1)
  position    Int

  /// Soft delete only. Editing a quiz must never destroy a participant's
  /// recorded responses — see QuizResponse.question below.
  retiredAt DateTime?

  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuizOption[]
  responses QuizResponse[]

  @@unique([quizId, questionKey])
  @@index([quizId, position])
}

model QuizOption {
  id         String @id @default(cuid())
  questionId String
  position   Int

  /// Choice text (SINGLE_CHOICE/TRUE_FALSE), the left-hand item (MATCHING),
  /// or the step text (ORDERING).
  text String

  /// MATCHING only — the right-hand item this option pairs with.
  matchText       String?
  /// SINGLE_CHOICE / TRUE_FALSE only.
  isCorrect       Boolean @default(false)
  /// ORDERING only — 1-based correct position.
  correctPosition Int?

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

model QuizAttempt {
  id String @id @default(cuid())

  /// Client-generated UUID. The idempotency key for the offline sync push —
  /// a retried push with the same id is a no-op, never a duplicate attempt.
  clientId String        @unique
  userId   String
  quizId   String
  locale   ContentLocale

  startedAt       DateTime
  completedAt     DateTime?
  scorePercent    Int?
  pointsAwarded   Int       @default(0)
  pointsPossible  Int       @default(0)
  passed          Boolean?
  durationSeconds Int?

  /// Ordinal for this user+quiz, assigned server-side at sync time.
  attemptNumber Int
  /// Quiz.version this attempt was taken against.
  quizVersion   Int      @default(1)
  syncedAt      DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict — a quiz with recorded attempts can never be deleted outright.
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Restrict)
  responses QuizResponse[]

  @@index([userId, quizId, startedAt])
  @@index([quizId, completedAt])
}

model QuizResponse {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  /// Shape depends on the question's type:
  ///   SINGLE_CHOICE/TRUE_FALSE -> { "optionId": "..." }
  ///   MATCHING -> { "pairs": [{ "optionId": "...", "matchOptionId": "..." }] }
  ///   ORDERING -> { "order": ["optionId", ...] }
  /// Graded server-side on sync; a client-supplied verdict is never trusted.
  answer        Json
  isCorrect     Boolean
  pointsAwarded Int      @default(0)
  answeredAt    DateTime

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: editing/retiring a question must never delete
  /// the responses already recorded against it.
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Rewards
//
// Engagement scaffolding for children aged 6-15: one badge per quiz.
// Deliberately *derived* state — every badge is recomputed
// from the QuizAttempt that earned it, so these tables can be rebuilt from
// scratch and carry no information the attempt data doesn't already have.
// That keeps them out of the research dataset's way: they are motivation,
// not measurement.
// ---------------------------------------------------------------------------

/// Score bands, highest first. A quiz scored below [BadgeTier.RISING]'s
/// threshold earns no badge at all — the app says "you gave it your best,
/// try again" rather than handing out a participation tier, which children
/// read straight through.
enum BadgeTier {
  /// 91-100%
  GOLD
  /// 81-90%
  SILVER
  /// 61-80%
  BRONZE
  /// 51-60%
  RISING
}

/// The single best badge a child holds for one quiz. Beating your own score
/// overwrites the row (see lib/services/badges.ts) — the collection shows a
/// child's best work per quiz, never a pile of every attempt, so retaking a
/// quiz can only ever improve the wall.
model QuizBadge {
  id     String @id @default(cuid())
  userId String
  quizId String

  tier         BadgeTier
  scorePercent Int
  /// The attempt that earned this badge, kept so the badge can always be
  /// traced back to real scored evidence.
  attemptId    String    @unique

  earnedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId, earnedAt])
}

// ---------------------------------------------------------------------------
// Progress + offline sync
//
// The mobile app is offline-first: topic views, completions and quiz
// attempts are recorded on-device and pushed in a batch when connectivity
// returns. SyncEvent is the idempotency ledger for that push — its primary
// key IS the client-generated id, so a retried push is provably a no-op
// rather than a guess based on timestamps.
// ---------------------------------------------------------------------------

enum SyncEventType {
  TOPIC_OPEN
  TOPIC_COMPLETION
  QUIZ_ATTEMPT
}

model TopicProgress {
  id     String @id @default(cuid())
  userId String

  /// EducationContent.slug — language-independent, so completing either the
  /// EN or TA article marks the same topic complete.
  topicSlug String
  /// Locale the participant most recently read it in.
  locale    ContentLocale

  firstOpenedAt DateTime
  lastOpenedAt  DateTime
  completedAt   DateTime?
  /// Accumulated across sessions. Safe to increment on sync only because
  /// SyncEvent already deduplicates the underlying events.
  secondsSpent  Int       @default(0)
  openCount     Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicSlug])
  @@index([topicSlug, completedAt])
  @@index([userId, completedAt])
}

/// One row per offline event the device has ever successfully pushed.
model SyncEvent {
  /// Client-generated UUIDv4 — both the idempotency key and the primary key.
  clientId String        @id
  userId   String
  type     SyncEventType

  /// Device-reported time of the event (may be skewed — see clockSkewSeconds).
  occurredAt       DateTime
  receivedAt       DateTime @default(now())
  /// occurredAt vs. server time at receipt, recorded for data-quality
  /// filtering. Cheap Android clocks drift; skew is never a rejection reason.
  clockSkewSeconds Int?
  deviceId         String?
  appVersion       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@index([type, occurredAt])
}

// ---------------------------------------------------------------------------
// Feature flags
//
// Deliberately NOT modelled on SystemSetting: that store's closed
// SETTING_DEFAULTS allowlist and admin-only read path are both correct for
// operational settings, but flags need a PATIENT-readable surface (the
// mobile splash screen reads content_lang_ta_enabled before sign-in) and
// per-flag safety metadata that doesn't belong in a JSON blob.
// ---------------------------------------------------------------------------

model FeatureFlag {
  /// One of the keys in lib/services/feature-flags.ts's FEATURE_FLAGS
  /// registry — that registry is the source of truth for which keys are
  /// valid, mirroring SETTING_DEFAULTS' closed-allowlist pattern.
  key     String  @id
  enabled Boolean @default(false)

  description    String
  /// Shown to an administrator before they may enable a clinicalSafety flag.
  safetyNotice   String?
  /// True for flags gating clinical content (dose calculators). Enabling
  /// one requires an explicit acknowledgement, recorded in the audit log.
  clinicalSafety Boolean @default(false)
  /// False keeps a flag server-side only (never returned by the public
  /// /api/feature-flags endpoint).
  publicRead     Boolean @default(true)

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Research
// ---------------------------------------------------------------------------

model ResearchStudy {
  id    String @id @default(cuid())
  code  String @unique
  title String

  description String?
  objective   String?
  status      StudyStatus @default(DRAFT)

  principalInvestigator String?
  irbNumber             String?
  consentVersion        String?
  startDate             DateTime?
  endDate               DateTime?
  targetEnrollment      Int?

  /// Health domains in scope for this study, e.g. ["glucose","hba1c","exercise"].
  dataPoints String[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                   @relation("StudyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants StudyParticipant[]
  access       StudyAccess[]
  exports      DataExport[]
  thresholds   ClinicalThreshold[]
  campaigns    NotificationCampaign[]

  @@index([status])
  @@index([createdAt])
}

model StudyParticipant {
  id      String @id @default(cuid())
  studyId String
  userId  String

  /// Study-scoped pseudonym used in exports.
  studyParticipantCode String
  enrollmentStatus     EnrollmentStatus @default(INVITED)
  armOrGroup           String?
  consentGivenAt       DateTime?
  enrolledAt           DateTime?
  withdrawnAt          DateTime?
  withdrawalReason     String?
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyId, userId])
  @@unique([studyId, studyParticipantCode])
  @@index([studyId, enrollmentStatus])
  @@index([userId])
}

/// Grants a researcher or reviewer access to a specific study's data.
model StudyAccess {
  id      String @id @default(cuid())
  studyId String
  userId  String

  role      StudyAccessRole @default(VIEWER)
  canExport Boolean         @default(false)

  grantedById String?
  grantedAt   DateTime @default(now())

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user  User          @relation("StudyAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyId, userId])
  @@index([userId])
}

model DataExport {
  id      String  @id @default(cuid())
  studyId String?

  datasetType String
  format      ExportFormat
  filters     Json
  status      ExportStatus @default(PENDING)

  rowCount    Int?
  fileKey     String?
  fileUrl     String?
  errorReason String?
  expiresAt   DateTime?
  completedAt DateTime?

  requestedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  study       ResearchStudy? @relation(fields: [studyId], references: [id], onDelete: SetNull)
  requestedBy User           @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([requestedById, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit and settings
// ---------------------------------------------------------------------------

/// Append-only record of sensitive operations. Never updated or deleted by the app.
model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actorEmail String?
  actorRole  UserRole?

  action        String
  resourceType  String
  resourceId    String?
  /// The participant whose data was involved, when applicable.
  participantId String?
  studyId       String?

  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  success     Boolean @default(true)

  createdAt DateTime @default(now())

  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User? @relation("AuditSubject", fields: [participantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([participantId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

model SystemSetting {
  key         String  @id
  value       Json
  category    String  @default("general")
  description String?

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
}
