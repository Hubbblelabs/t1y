// Digital Diabetes Management Platform — database schema
//
// Design notes
// ------------
// * Physiological measurements are stored as `Float` (PostgreSQL `double precision`).
//   The clinically relevant ranges (glucose 20–600 mg/dL, HbA1c 3–20 %, weight, etc.)
//   are represented exactly enough by IEEE-754 doubles, and it keeps aggregation
//   (avg/min/max) and JSON serialisation straightforward.
// * There is exactly one identity table (`User`). Role-specific detail lives in
//   `Profile` (patients) and `AdminUser` (staff). User data is never duplicated
//   across domain tables — they reference `userId`.
// * Every table that is queried by "participant + date range" carries a composite
//   index in that order, because health history grows without bound.
// * Clinically meaningful thresholds are NOT hard-coded anywhere in the product.
//   They live in `ClinicalThreshold` and must be configured by a clinician.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// This deployment serves one study with one operating team — ADMIN is the
/// single staff role, holding every staff capability (see
/// lib/permissions/roles.ts). The platform's original SUPER_ADMIN,
/// RESEARCHER and CLINICAL_REVIEWER distinctions belonged to a
/// multi-study, multi-team deployment this one isn't.
enum UserRole {
  PATIENT
  ADMIN
}

