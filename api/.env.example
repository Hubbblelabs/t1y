# Copy to .env and fill in. See lib/env.ts for the full validation schema.

NODE_ENV=development

# --- Database (required) ---------------------------------------------------
# Hosted Postgres — Neon or Supabase free tier. Use the POOLED connection
# string for DATABASE_URL (serverless-friendly); DIRECT_DATABASE_URL is the
# unpooled string, used only for `prisma migrate`.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (required) --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"

# --- Email (optional in dev — logs instead of sending when unset) ----------
# RESEND_API_KEY=
# EMAIL_FROM="T1D Prajana Yandra <no-reply@example.com>"

# --- Media storage (optional — Cloudflare R2, used by content import) ------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# --- Observability (optional) ----------------------------------------------
# SENTRY_DSN=

# --- Cron (optional locally — required in production for /api/cron/*) ------
# CRON_SECRET=

# --- Dev/test only -----------------------------------------------------------
# SEED_DEFAULT_PASSWORD=ChangeMe!2024
# DISABLE_RATE_LIMIT=true

# --- Content import (used by scripts/import-content.ts) ---------------------
# IMPORT_AUTHOR_EMAIL=admin@example.com
